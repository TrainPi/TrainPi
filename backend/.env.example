# Copy this file to .env and fill in real values. Never commit .env.

# Database (Neon Postgres, or any Postgres connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth
SECRET_KEY=generate-a-random-64-char-hex-value-do-not-use-a-placeholder
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS / URLs
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# SMTP (email) - Gmail App Password recommended, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# YouTube (course-matching fallback search) - https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Adzuna (job search) - free signup at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# AI provider (Gemini only) - https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Stripe (credit purchases)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth login - https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redis cache (Upstash - free tier signup at https://console.upstash.com/)
# Falls back to in-memory caching automatically when these are blank.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Read replica (optional - only set once a Neon paid-tier replica exists;
# reads route to the primary automatically when this is blank)
REPLICA_DATABASE_URL=

# Error tracking (Sentry - free tier signup at https://sentry.io/)
# No-op when blank.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Object storage (Cloudflare R2 - S3-compatible, free tier signup at
# https://dash.cloudflare.com/ -> R2). Used for user-uploaded files that
# need to persist (currently: avatars). Falls back to local disk (dev-only,
# NOT viable on Vercel) when blank.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Encryption at rest for resume text / uploaded org document text (PII and
# confidential SOPs). Blank = stored as plaintext (current default). Generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store this somewhere durable outside of .env once set (e.g. a secrets
# manager) — losing it makes existing encrypted rows unreadable.
ENCRYPTION_KEY=

# DB connection pool tuning (optional - safe defaults apply if unset)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=1800
